<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11 及以下的蓝牙权限（普通权限，安装即授予） -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 12 及以上：连接 / 扫描 / 对外广播（注册成 HID 需要 ADVERTISE） -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_k"
        android:label="AirMouse"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- 真正的界面。launcher 入口都在下面的 alias 上，便于动态换图标 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!--
            桌面图标通过 activity-alias 实现动态切换：
            同一时刻只启用一个 alias，其余禁用。见 IconManager.kt。
            第一列：G / I / K（G 无外圈，I、K 是半圈高亮）
            第二列：G2 / I2 / K2（外圈整圈高亮）
            默认启用 K。
        -->
        <activity-alias
            android:name=".IconG"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_g"
            android:label="AirMouse"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconI"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_i"
            android:label="AirMouse"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconK"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_k"
            android:label="AirMouse"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconG2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_g2"
            android:label="AirMouse"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconI2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_i2"
            android:label="AirMouse"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconK2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_k2"
            android:label="AirMouse"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
