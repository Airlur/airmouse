<?xml version="1.0" encoding="utf-8"?>
<!--
  方案 G：浅底 + 蓝色圆环 + 蓝色鼠标
  外圈与四分之一高亮弧都在（之前误删，已恢复）
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 完整圆环（淡） -->
    <path
        android:pathData="M54,28 A26,26 0 1,1 53.9,28 Z"
        android:strokeColor="#44007AFF"
        android:strokeWidth="2.2"
        android:fillColor="#00000000" />

    <!-- 高亮圆弧：顶部到右侧 -->
    <path
        android:pathData="M54,28 A26,26 0 0,1 80,54"
        android:strokeColor="#007AFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 鼠标轮廓（描边胶囊） -->
    <path
        android:pathData="M45,50 A9,9 0 0,1 63,50 L63,58 A9,9 0 0,1 45,58 Z"
        android:strokeColor="#007AFF"
        android:strokeWidth="2.6"
        android:fillColor="#00000000" />

    <!-- 中缝 -->
    <path
        android:pathData="M54,41 L54,50"
        android:strokeColor="#007AFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
